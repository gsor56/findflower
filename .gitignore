# --- Secrets / credentials (NEVER commit) ---
kaggle.json
.kaggle/
*.env
.env
.env.*
*secret*.txt
# Token files sitting in the repo root. `*secret*.txt` did NOT match
# "github_token(classic).txt", so a `git add -A` would have committed a live
# GitHub PAT to a public repo. Match on the credential words themselves.
*token*.txt
*token*.json
*_pat.txt
credentials.json
# A whole directory of live credentials (a GitHub PAT among them) kept outside
# git. `git add -A` would otherwise commit it to this public repo.
my-secrets/
# Holds a live provider api_key inline; the repo is public.
proxy/litellm-config.yaml

# --- Model weights: far over GitHub's 100MB file cap; live in the HF model repo ---
# Both halves of the external-data format matter: the .onnx protobuf is small,
# but its .onnxdata weights sibling is ~327MB.
*.onnx
*.onnxdata
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
/training/data/
/training/checkpoint/
/training/output/

# Local Hub validation/download caches; the canonical dataset lives remotely.
.hf-validation-cache/
.hf-audit-cache/
.duplicate-audit/
.final-hub-index/

# --- Build output ---
# _site/ is assembled by .github/workflows/pages.yml at deploy time.
_site/
node_modules/
.wrangler/

# --- Python caches ---
__pycache__/
*.pyc
*.pyo

# --- Local tooling / editor state ---
.claude/
.vscode/
.idea/

# --- Scratch: leading underscore marks throwaway probes and logs ---
_klog/
_onnx_probe/
_scratch/

# --- OS junk ---
Thumbs.db
.DS_Store
.aider*

# --- Dataset curation and one-off maintenance scripts: local-only by request ---
# These are untracked but were not ignored, so a `git add -A` would have
# published them. The dataset itself lives in the HF repo, not here.
.ffpatch/
.kaggle-log-only/
.kaggle-log-latest/
.kaggle-output-v8/
curation/
hf_*.json
/cnn_class_names.json
/flower_model/
/find10k_output/
/remote_find10k/
/secret_meta/
/find10k_kaggle_log*.txt
/kaggle_logs*.txt
/scripts/build_curation_shards.py
/scripts/build_top_plantae_manifest.py
/scripts/validate_premium_dataset.py
