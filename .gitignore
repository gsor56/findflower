# --- Secrets / credentials (NEVER commit) ---
kaggle.json
*.env
.env
*secret*.txt
# Token files sitting in the repo root. `*secret*.txt` did NOT match
# "github_token(classic).txt", so a `git add -A` would have committed a live
# GitHub PAT to a public repo. Match on the credential words themselves.
*token*.txt
*token*.json
*_pat.txt
credentials.json
# Holds a live provider api_key inline; the repo is public.
proxy/litellm-config.yaml

# --- Model weights: far over GitHub's 100MB file cap; live in the HF model repo ---
# Both halves of the external-data format matter: the .onnx protobuf is small,
# but its .onnxdata weights sibling is ~327MB.
*.onnx
*.onnxdata

# --- Build output ---
# _site/ is assembled by .github/workflows/pages.yml at deploy time.
_site/
node_modules/
.wrangler/

# --- Python caches ---
__pycache__/
*.pyc
*.pyo

# --- Local tooling / editor state ---
.claude/
.vscode/
.idea/

# --- Scratch: leading underscore marks throwaway probes and logs ---
_klog/
_onnx_probe/
_scratch/

# --- OS junk ---
Thumbs.db
.DS_Store
.aider*
